      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    title Interrupted action: discovering the authoritative outcome\n    actor U as User\n    participant M as Mobile app\n    participant S as Web service\n    participant D as SQLite database\n\n    U-&gt;&gt;M: Confirm buy USD\n    M-&gt;&gt;M: Create request ID, save pending intent\n    M-&gt;&gt;S: POST /trades (Idempotency-Key = K)\n    Note over M,S: Connection is lost, no response within 5 s\n    M--&gt;&gt;U: Result uncertain (not success, not failure)\n    M-&gt;&gt;M: Keep pending intent, wait for connectivity\n\n    Note over M,S: Connectivity restored\n    M-&gt;&gt;S: GET /trades/by-key/K (JWT)\n    S-&gt;&gt;D: Look up K\n    alt Server committed, response was lost\n        D--&gt;&gt;S: Stored result\n        S--&gt;&gt;M: 200 transaction result\n        M--&gt;&gt;U: Show completed trade, refresh wallet and history\n    else Server never received the request\n        D--&gt;&gt;S: Not found\n        S--&gt;&gt;M: 404\n        M-&gt;&gt;S: POST /trades (same Idempotency-Key = K)\n        S-&gt;&gt;D: Execute once, store K + response\n        S--&gt;&gt;M: 201 transaction result\n        M--&gt;&gt;U: Show completed trade\n    end\n    M-&gt;&gt;M: Clear pending intent&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GnwgxLcOIlGdDuwVaWJ9-1">
