  <diagram name="Page-1" id="zNFf4swqWjhn33Ofhavx">
    <mxGraphModel dx="2555" dy="1410" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    title Data-changing action: buy currency\n    actor U as User\n    participant M as Mobile app\n    participant S as Web service\n    participant D as SQLite database\n\n    U-&gt;&gt;M: Confirm buy USD\n    M-&gt;&gt;M: Create request ID (UUID), save pending intent\n    M-&gt;&gt;S: POST /trades (JWT, Idempotency-Key)\n    S-&gt;&gt;S: Verify JWT (authentication and authorisation)\n    S-&gt;&gt;S: Validate input (side, currency, amount)\n    S-&gt;&gt;D: Look up Idempotency-Key\n    alt Key already stored\n        D--&gt;&gt;S: Stored response\n        S--&gt;&gt;M: Stored response (same result, no new trade)\n    else New key\n        S-&gt;&gt;D: Start transaction\n        S-&gt;&gt;D: Read latest rate and wallet balances\n        S-&gt;&gt;S: Check sufficient balance\n        S-&gt;&gt;D: Update wallets, insert transaction, store key + response\n        S-&gt;&gt;D: Commit\n        Note over S,D: The service decides the outcome. The trade is successful only after the commit.\n        S--&gt;&gt;M: 201 transaction, rate used, new balances\n    end\n    M-&gt;&gt;M: Clear pending intent, update cache\n    M--&gt;&gt;U: Show success only now (after server confirmation)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="cwHFEU4uMXeMzEDZ7BTD-1">
