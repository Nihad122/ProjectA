        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    %% Mobile side\n    class RatesScreen\n    class WalletScreen\n    class TradeScreen {\n        +submit()\n    }\n    class ApiClient {\n        +timeoutMs\n        +request(opts)\n    }\n    class RetryPolicy {\n        +maxAttempts\n        +backoff()\n    }\n    class ConnectivityMonitor {\n        +isOnline()\n        +onChange()\n    }\n    class LocalCache {\n        +get(key)\n        +set(key, value, timestamp)\n        +age(key)\n    }\n    class PendingIntentStore {\n        +save(key, intent)\n        +list()\n        +clear(key)\n    }\n\n    RatesScreen --&gt; LocalCache\n    WalletScreen --&gt; LocalCache\n    TradeScreen --&gt; ApiClient\n    TradeScreen --&gt; PendingIntentStore\n    ApiClient --&gt; RetryPolicy\n    ApiClient --&gt; ConnectivityMonitor\n\n    %% Service side\n    class AuthController\n    class RatesController\n    class TradeController\n    class TradeService {\n        +execute(userId, key, request)\n        +statusByKey(userId, key)\n    }\n    class IdempotencyService {\n        +find(key)\n        +store(key, response)\n    }\n    class RateService {\n        +latest(code)\n        +history(code, days)\n    }\n    class NbpClient {\n        +fetchTableC()\n        +fetchTableA()\n    }\n    class Repository\n\n    TradeController --&gt; TradeService\n    TradeService --&gt; IdempotencyService\n    TradeService --&gt; RateService\n    TradeService --&gt; Repository\n    RatesController --&gt; RateService\n    RateService --&gt; NbpClient\n    RateService --&gt; Repository\n    ApiClient ..&gt; TradeController : HTTPS/JSON\n    ApiClient ..&gt; RatesController : HTTPS/JSON\n    ApiClient ..&gt; AuthController : HTTPS/JSON\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="gWJdYy2waM-Bvk2J-9sO-1">
